{{!-- 보완 등록 상세: 상위기관 열람 --}}
<section class="modal _content draggable" id="supRegViewModal" style="display:none;">
  <div class="st_view">
    <div class="st_container st_container--review">
      <header class="st_header_g">
        <h1>보완 등록 상세: 상위기관 열람</h1>
        <button type="button" title="창닫기" onclick="$('#supRegViewModal').fadeOut();"></button>
      </header>

      <div class="i-review">
        <div class="i-alert i-alert--ok" role="status">
          <span class="i-alert__ico i-alert__ico--ok" aria-hidden="true">✓</span>
          <div class="i-alert__body">
            <p class="i-alert__ti">시도 담당자가 보완자료를 등록했습니다.</p>
            <p class="i-alert__desc">등록된 보완의견, 세부 보완사항 및 첨부파일을 확인해 주세요.</p>
          </div>
        </div>

        <div class="tbl-col-wrap i-form i-form--review">
          <table>
            <colgroup>
              <col style="width: 160px">
              <col>
            </colgroup>
            <tbody>
              <tr>
                <th scope="row">요청기관 <span class="i-req" aria-hidden="true">*</span></th>
                <td>해양수산부 1차 검토 · 해양공간정책과</td>
              </tr>
              <tr>
                <th scope="row">등록기관 <span class="i-req" aria-hidden="true">*</span></th>
                <td>시도 담당자 · 충청남도</td>
              </tr>
              <tr>
                <th scope="row">등록일자 <span class="i-req" aria-hidden="true">*</span></th>
                <td>2026-07-28</td>
              </tr>
              <tr>
                <th scope="row">보완의견 <span class="i-req" aria-hidden="true">*</span></th>
                <td>
                  <div class="i-review__box">요청한 이행실적 증빙자료를 보완하여 제출합니다.</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="i-review__attach">
          <h3 class="i-sec-ti i-sec-ti--sm">첨부 파일</h3>
          <div class="i-filebox">
            <a href="#" class="i-filebox__item">
              <span class="i-filebox__clip" aria-hidden="true"></span>
              <span>이행실적_증빙자료.pdf · 2.4MB</span>
            </a>
          </div>
        </div>

        <div class="i-review__foot">
          <button type="button" class="i-btn i-btn--cancel" onclick="$('#supRegViewModal').fadeOut();">닫기</button>
        </div>
      </div>
    </div>
    <div class="dimmed" onclick="$('#supRegViewModal').fadeOut();"></div>
  </div>
</section>
