{{!-- 목록용 미니 스테퍼 — step: 현재 단계(1~5) --}}
<div class="i-pstep" aria-label="현재 단계 {{step}}">
  <div class="i-pstep__item {{stepState step 1}}">
    <span class="i-pstep__lab">기초 지자체<br>이행점검 결과등록</span>
    <span class="i-pstep__dot" aria-hidden="true"></span>
  </div>
  <div class="i-pstep__item {{stepState step 2}}">
    <span class="i-pstep__lab">시도 담당자<br>검토</span>
    <span class="i-pstep__dot" aria-hidden="true"></span>
  </div>
  <div class="i-pstep__item {{stepState step 3}}">
    <span class="i-pstep__lab">해양수산부<br>1차 검토</span>
    <span class="i-pstep__dot" aria-hidden="true"></span>
  </div>
  <div class="i-pstep__item {{stepState step 4}}">
    <span class="i-pstep__lab">전문기관<br>검토</span>
    <span class="i-pstep__dot" aria-hidden="true"></span>
  </div>
  <div class="i-pstep__item {{stepState step 5}}">
    <span class="i-pstep__lab">해양수산부<br>최종 검토 및 승인</span>
    <span class="i-pstep__dot" aria-hidden="true"></span>
  </div>
</div>
