{{!-- 이행점검 진행 이력 (공통) — currentStep별 행 --}}
<section class="i-rpage__sec" aria-labelledby="rhistTitle">
  <div class="i-rhist__head">
    <h2 id="rhistTitle" class="i-sec-ti">이행점검 진행 이력</h2>
    <button type="button" class="i-btn i-btn--solid i-btn--sm" id="btnReviewOpinion" onclick="$('#reviewOpinionModal').fadeIn(); return false;">검토의견 등록</button>
  </div>

  <div class="tbl-wrap i-list i-rhist">
    <table>
      <caption>이행점검 진행 이력</caption>
      <colgroup>
        <col style="width: 16%">
        <col style="width: 12%">
        <col style="width: 8%">
        <col style="width: 12%">
        <col>
        <col style="width: 16%">
        <col style="width: 12%">
      </colgroup>
      <thead>
        <tr>
          <th scope="col">진행단계</th>
          <th scope="col">상세단계</th>
          <th scope="col">상태</th>
          <th scope="col">일자</th>
          <th scope="col">내용</th>
          <th scope="col">첨부파일</th>
          <th scope="col">등록자</th>
        </tr>
      </thead>
      <tbody>
        {{#ifeq currentStep 3}}
          {{> i-rhist-rows-03}}
        {{else}}
          {{#ifeq currentStep 4}}
            {{> i-rhist-rows-03}}
          {{else}}
            {{#ifeq currentStep 5}}
              {{> i-rhist-rows-03}}
            {{else}}
              {{> i-rhist-rows-02}}
            {{/ifeq}}
          {{/ifeq}}
        {{/ifeq}}
      </tbody>
    </table>
  </div>
</section>
