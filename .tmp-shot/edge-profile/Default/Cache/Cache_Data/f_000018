@font-face {
  font-family: "Pretendard GOV";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/public/fonts/PretendardGOV-Regular.subset.woff2") format("woff2"), url("/public/fonts/PretendardGOV-Regular.subset.woff") format("woff");
}
@font-face {
  font-family: "Pretendard GOV";
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url("/public/fonts/PretendardGOV-Medium.subset.woff2") format("woff2"), url("/public/fonts/PretendardGOV-Medium.subset.woff") format("woff");
}
@font-face {
  font-family: "Pretendard GOV";
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url("/public/fonts/PretendardGOV-Bold.subset.woff2") format("woff2"), url("/public/fonts/PretendardGOV-Bold.subset.woff") format("woff");
}
@font-face {
  font-family: "Pretendard GOV";
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url("/public/fonts/PretendardGOV-Bold.subset.woff2") format("woff2"), url("/public/fonts/PretendardGOV-Bold.subset.woff") format("woff");
}
@font-face {
  font-family: MOF;
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url("/public/fonts/MOF_B.woff") format("woff");
}
*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
}

body {
  overflow: hidden;
  font-family: "Pretendard GOV", sans-serif;
  font-size: 15px;
  line-height: 1.5;
  color: #1e2124;
  background: #fff;
}

button,
input,
select {
  font: inherit;
  color: inherit;
}

button {
  padding: 0;
  border: 0;
  background: none;
  cursor: pointer;
}

img {
  display: block;
  max-width: 100%;
}

p {
  margin: 0;
}

ul,
ol {
  margin: 0;
  padding: 0;
  list-style: none;
}

.skip {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 200;
  margin: 0;
  padding: 0;
  list-style: none;
}

.skip a {
  position: absolute;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  clip-path: inset(50%);
  white-space: nowrap;
  color: #fff;
  background: #0e388e;
}

.skip a:focus-visible {
  width: auto;
  height: auto;
  padding: 8px 12px;
  overflow: visible;
  clip: auto;
  clip-path: none;
  outline: 2px solid #fff;
  outline-offset: 2px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

:focus-visible {
  outline: 2px solid #407ad0;
  outline-offset: 2px;
}

.masthead {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  width: 100%;
  height: 32px;
  padding: 0 10px;
  background: #eef2f7;
}
.masthead__flag {
  width: 24px;
  height: 24px;
  overflow: hidden;
}
.masthead__flag img {
  width: 24px;
  height: 16px;
  margin-top: 4px;
}
.masthead__txt {
  margin-left: 8px;
  font-size: 15px;
  color: #1e2124;
  white-space: nowrap;
}

.gnb {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 70px;
  height: 100%;
  padding: 20px 0;
  border-radius: 16px;
  overflow: hidden;
}
.gnb::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background-image: linear-gradient(180deg, rgba(33, 117, 182, 0.6) 0%, rgba(161, 197, 225, 0.6) 100%), linear-gradient(90deg, #fff 0%, #fff 100%);
}
.gnb::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: url("../../assets/img/glass-card.png") center/cover no-repeat;
  opacity: 0.7;
}
.gnb__top, .gnb__btm, .gnb__logo, .gnb__list, .gnb__item {
  position: relative;
  z-index: 1;
}
.gnb__top {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30px;
}
.gnb__logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
  text-decoration: none;
  color: #000;
}
.gnb__symbol {
  width: 36px;
  height: 36px;
}
.gnb__symbol img {
  width: 36px;
  height: 36px;
}
.gnb__name {
  font-family: MOF, "Pretendard GOV", sans-serif;
  font-size: 13px;
  font-weight: 700;
  line-height: 18px;
  white-space: nowrap;
}
.gnb__list {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  padding: 0 12px;
}
.gnb__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 46px;
  text-decoration: none;
}
.gnb__ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  background: #fff;
  overflow: hidden;
}
.gnb__ico img {
  width: 24px;
  height: 24px;
}
.gnb__label {
  font-size: 12px;
  line-height: 1.2;
  text-align: center;
  color: #33363d;
  white-space: nowrap;
}
.gnb__item.is-active .gnb__ico {
  background: #407ad0;
}
.gnb__item.is-active .gnb__label {
  font-weight: 700;
  color: #131416;
}
.gnb__btm {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  width: 46px;
}
.gnb__util {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  text-decoration: none;
}
.gnb__util-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 50px;
  background: #fff;
  overflow: hidden;
}
.gnb__util-ico img {
  width: 15px;
  height: 15px;
}
.gnb__util-label {
  font-size: 12px;
  line-height: 1.2;
  text-align: center;
  color: #131416;
  white-space: nowrap;
}

.panel {
  display: flex;
  align-items: flex-start;
  height: 100%;
}
.panel__body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24px;
  width: 360px;
  height: 100%;
  padding: 24px 16px;
  border-radius: 16px;
  overflow: hidden;
}
.panel__body::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background-image: linear-gradient(180deg, rgba(33, 117, 182, 0.3) 0%, rgba(161, 197, 225, 0.3) 100%), linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.5) 100%);
}
.panel__body::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: url("../../assets/img/glass-panel.png") center/cover no-repeat;
  opacity: 0.4;
}
.panel__tabs, .panel__search, .panel__list, .panel__empty {
  position: relative;
  z-index: 1;
}
.panel__empty {
  margin: 24px 8px;
  font-size: 14px;
  color: #58616a;
  text-align: center;
}
.panel__tabs {
  display: flex;
  gap: 5px;
  width: 100%;
}
.panel__tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 15px;
  color: #464c53;
  background: #fff;
  white-space: nowrap;
}
.panel__tab.is-active {
  font-weight: 700;
  color: #fff;
  background: #1e2124;
}
.panel__search {
  display: flex;
  gap: 5px;
  width: 328px;
  height: 46px;
}
.panel__field {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 46px;
  padding-left: 16px;
  border: 2px solid #3066bd;
  border-radius: 8px;
  background: #fff;
}
.panel__input {
  flex: 1;
  min-width: 0;
  height: 100%;
  border: 0;
  outline: none;
  background: none;
}
.panel__input::placeholder {
  color: #666;
}
.panel__search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 100%;
  border-radius: 0 12px 12px 0;
  background: #3066bd;
}
.panel__search-btn img {
  width: 16px;
  height: 16px;
}
.panel__filter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border-radius: 8px;
  background: #29467b;
  cursor: pointer;
}
.panel__filter img {
  width: 24px;
  height: 24px;
}
.panel__list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 1;
  min-height: 0;
  overflow: auto;
}
.panel__handle {
  display: flex;
  align-items: center;
  padding-top: 87px;
  width: 20px;
}
.panel__handle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 42px;
  border-radius: 0 12px 12px 0;
  background: #fff;
}
.panel__handle-btn img {
  width: 16px;
  height: 16px;
}

.count {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 20px;
  border: 1px solid #cdd1d5;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  color: #58616a;
  background: #fff;
}
.count.is-on {
  border: 0;
  color: #fff;
  background: #3066bd;
}
.count.is-zero {
  border: 0;
  color: #407ad0;
  background: #e2eefc;
}

.chk {
  position: relative;
  display: inline-flex;
  flex-shrink: 0;
  width: 18px;
  height: 18px;
}
.chk__input {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 18px;
  height: 18px;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}
.chk__box {
  display: block;
  width: 18px;
  height: 18px;
  border: 1px solid #8a949e;
  border-radius: 4px;
  background: #fff;
}
.chk__input:checked + .chk__box {
  border-color: #fff;
  background: #0e388e url("../../assets/img/icon/check.svg") center/16px 16px no-repeat;
}
.chk__input:focus-visible + .chk__box {
  outline: 2px solid #407ad0;
  outline-offset: 2px;
}

.lyr-mark {
  width: 16px;
  height: 16px;
  overflow: hidden;
  border-radius: 2px;
  background: #ef0060;
}

.lyr-zone {
  display: flex;
  flex-direction: column;
  width: 16px;
  height: 13px;
  margin-top: 1.5px;
}
.lyr-zone span {
  display: block;
  width: 100%;
  height: 2.5px;
  border: 0.5px solid #000;
  border-bottom: 0;
}
.lyr-zone span:nth-child(1) {
  background: #f00;
}
.lyr-zone span:nth-child(2) {
  background: #ffc800;
}
.lyr-zone span:nth-child(3) {
  background: #b6ff8f;
}
.lyr-zone span:nth-child(4) {
  background: #33c2ff;
}
.lyr-zone span:nth-child(5) {
  height: 3px;
  border: 0.5px solid #000;
  background: #fff;
}

.tree {
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 328px;
}
.tree--sub {
  gap: 4px;
}
.tree__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 328px;
  height: 46px;
  padding: 0 16px;
  border: 0;
  border-radius: 8px;
  background: #0e388e;
  cursor: pointer;
  text-align: left;
}
.tree__head-txt {
  font-size: 17px;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
}
.tree__head-right {
  display: flex;
  align-items: center;
  gap: 10px;
}
.tree__head-ico {
  width: 16px;
  height: 16px;
}
.tree__head-ico img {
  width: 16px;
  height: 16px;
}
.tree .ico-open {
  display: none;
}
.tree .ico-close {
  display: block;
}
.tree .is-open > .tree__head-right .ico-open,
.tree .is-open > .tree__row-right .ico-open,
.tree .is-open > .tree__d3-right .ico-open,
.tree .is-open > .tree__d4-ico .ico-open, .tree__head.is-open .ico-open, .tree__row.is-open .ico-open, .tree__d3.is-open .ico-open, .tree__d4-right.is-open .ico-open {
  display: block;
}
.tree .is-open > .tree__head-right .ico-close,
.tree .is-open > .tree__row-right .ico-close,
.tree .is-open > .tree__d3-right .ico-close,
.tree .is-open > .tree__d4-ico .ico-close, .tree__head.is-open .ico-close, .tree__row.is-open .ico-close, .tree__d3.is-open .ico-close, .tree__d4-right.is-open .ico-close {
  display: none;
}
.tree__head.is-sub {
  border: 1px solid #0e388e;
  background: rgba(14, 56, 142, 0.4);
}
.tree__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 328px;
  border: 0;
  height: 46px;
  padding: 0 17px;
  border: 1px solid #74aee9;
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
  font: inherit;
  text-align: left;
}
.tree__row-txt {
  font-size: 17px;
  color: #33363d;
  white-space: nowrap;
}
.tree__row-right {
  display: flex;
  align-items: center;
  gap: 10px;
}
.tree__row-ico {
  width: 16px;
  height: 16px;
}
.tree__row-ico img {
  width: 16px;
  height: 16px;
}
.tree__group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
}
.tree > .tree__group {
  display: none;
}
.tree > .tree__group.is-open {
  display: flex;
}
.tree__group.is-open > .tree__row.is-open {
  border: 0;
  border-radius: 8px 8px 0 0;
  background: #fff url("../../assets/img/depth2.png") center/cover no-repeat;
}
.tree__group.is-open > .tree__row.is-open .tree__row-txt {
  font-weight: 700;
  color: #0e388e;
}
.tree__kids {
  display: none;
  width: 100%;
  overflow: hidden;
  border-radius: 0 0 8px 8px;
}
.tree__group.is-open > .tree__kids {
  display: flex;
  flex-direction: column;
}
.tree__leaves {
  display: none;
  flex-direction: column;
  width: 100%;
}
.tree__branch.is-open > .tree__leaves {
  display: flex;
}
.tree__d3 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 42px;
  font: inherit;
  text-align: left;
  cursor: pointer;
  padding: 0 16px;
  border-bottom: 1px solid #fff;
  background: rgba(255, 255, 255, 0.5);
}
.tree__d3-txt {
  font-size: 15px;
  color: #33363d;
  white-space: nowrap;
}
.tree__d3-right {
  display: flex;
  align-items: center;
  gap: 10px;
}
.tree__d3-ico {
  width: 18px;
  height: 18px;
}
.tree__d3-ico img {
  width: 18px;
  height: 18px;
}
.tree__d3.is-open {
  border-bottom: 2px solid #3066bd;
  background: #fff;
}
.tree__d3.is-open .tree__d3-txt {
  font-weight: 700;
  color: #0e388e;
}
.tree__d3.is-open .count {
  border: 0;
  color: #fff;
  background: #3066bd;
}
.tree__branch {
  display: none;
  width: 100%;
}
.tree__branch.is-open {
  display: block;
}
.tree__d4 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 42px;
  padding: 0 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.3);
}
.tree__d4-left {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}
.tree__d4-txt {
  font-size: 15px;
  color: #33363d;
  white-space: nowrap;
}
.tree__d4.is-on .tree__d4-txt {
  font-weight: 700;
  color: #0e388e;
}
.tree__d4-right {
  display: flex;
  align-items: center;
  gap: 10px;
  background: none;
  border: 0;
  cursor: pointer;
}
.tree__d4-ico {
  width: 18px;
  height: 18px;
}
.tree__d4-ico img {
  width: 18px;
  height: 18px;
}
.tree__d5, .tree__d6 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 36px;
  padding-right: 16px;
  background: rgba(255, 255, 255, 0.3);
}
.tree__d5-left, .tree__d6-left {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 40px;
}
.tree__line {
  width: 40px;
  height: 40px;
}
.tree__line img {
  width: 40px;
  height: 40px;
}
.tree__line--d6 {
  width: 67px;
  height: 40px;
}
.tree__line--d6 img {
  width: 67px;
  height: 40px;
}
.tree__d5-txt, .tree__d6-txt {
  display: flex;
  align-items: center;
  gap: 10px;
}
.tree__leaf {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 15px;
  font-weight: 700;
  color: #33363d;
  white-space: nowrap;
}
.tree__leaf.is-off {
  font-weight: 400;
}
.tree__acts {
  display: flex;
  align-items: center;
  gap: 10px;
}
.tree__acts button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
}
.tree__acts img {
  width: 20px;
  height: 20px;
}

.suggest {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 40px;
  padding: 0 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 30px;
  backdrop-filter: blur(5px);
  background-image: linear-gradient(180deg, rgba(81, 121, 168, 0.1) 0%, rgba(45, 93, 154, 0.1) 33.646%, rgba(44, 42, 80, 0.1) 65.417%, rgba(43, 57, 103, 0.1) 100%), linear-gradient(90deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.4) 100%);
}
.suggest__title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 700;
  color: #29467b;
  text-shadow: 0 1px 2px #fff;
  white-space: nowrap;
}
.suggest__title img {
  width: 20px;
  height: 20px;
}
.suggest__list {
  display: flex;
  align-items: center;
  gap: 4px;
}
.suggest__chip {
  display: flex;
  align-items: center;
  gap: 4px;
  height: 24px;
  padding: 0 12px;
  border: 1px solid #8a949e;
  border-radius: 18px;
  font-size: 15px;
  color: #1e2124;
  background: #fff;
  white-space: nowrap;
}
.suggest__chip img {
  width: 16px;
  height: 16px;
}
.suggest__more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  width: 37px;
  height: 24px;
  padding: 0 10px;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 0 2px rgba(0, 0, 0, 0.25);
}
.suggest__more i {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #aaa;
}
.suggest__next {
  display: flex;
  flex: 0 0 20px;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  min-width: 20px;
  min-height: 20px;
  max-width: 20px;
  max-height: 20px;
  padding: 0;
  overflow: hidden;
  line-height: 0;
  border-radius: 50%;
  background: #407ad0;
}
.suggest__next img {
  width: 16px;
  height: 16px;
  max-width: 16px;
  max-height: 16px;
  transform: rotate(180deg);
}

.tools {
  position: absolute;
  top: 42px;
  right: 10px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  width: 65px;
  height: calc(100% - 52px);
  padding: 20px 0;
  border-radius: 16px;
  overflow: hidden;
}
.tools::before {
