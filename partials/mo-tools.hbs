<aside class="mo-tools" aria-label="지도 도구">
  <div class="mo-tools__item">
    <button type="button" class="mo-tools__btn" data-action="tool" data-tool="layer" aria-label="레이어"></button>
    <span class="mo-tools__label">레이어</span>
  </div>
  <div class="mo-tools__item">
    <button type="button" class="mo-tools__btn" data-action="tool" data-tool="basemap" aria-label="배경지도"></button>
    <span class="mo-tools__label">배경지도</span>
  </div>
  <div class="mo-tools__item">
    <button type="button" class="mo-tools__btn" data-action="tool" data-tool="fullmap" aria-label="전체지도"></button>
    <span class="mo-tools__label">전체지도</span>
  </div>
  <div class="mo-tools__zoom">
    <button type="button" class="mo-tools__zoom-btn" data-action="zoom" data-dir="in" aria-label="확대"></button>
    <button type="button" class="mo-tools__zoom-btn" data-action="zoom" data-dir="out" aria-label="축소"></button>
  </div>
</aside>
