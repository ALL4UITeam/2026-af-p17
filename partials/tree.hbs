<div class="tree" id="treeEval">
  <div class="tree__group">
    <div class="tree__row tree__row--on">
      <label class="tree__main">
        <input class="tree__check" type="checkbox" name="tree" checked>
        <span class="tree__zone" aria-hidden="true"></span>
        <span class="tree__name">어업활동특성평가</span>
      </label>
      <button type="button" class="tree__fold" aria-expanded="true" aria-controls="treeFish" aria-label="어업활동특성평가 접기">
        <img class="tree__chev-off" src="./src/assets/img/tree/chev-right.svg" width="12" height="12" alt="">
        <img class="tree__chev-on" src="./src/assets/img/tree/chev-down.svg" width="12" height="12" alt="">
      </button>
    </div>
    <div class="tree__kids" id="treeFish">
      <div class="tree__group">
        <div class="tree__sub tree__sub--on">
          <span class="tree__line" aria-hidden="true">
            <img src="./src/assets/img/tree/line-d4.svg" alt="">
          </span>
          <label class="tree__main">
            <input class="tree__check" type="checkbox" name="tree" checked>
            <span class="tree__name">어획</span>
          </label>
          <span class="tree__right">
            <span class="tree__count">3</span>
            <button type="button" class="tree__fold" aria-expanded="true" aria-controls="treeCatch" aria-label="어획 접기">
              <img class="tree__chev-off" src="./src/assets/img/tree/chev-right.svg" width="12" height="12" alt="">
              <img class="tree__chev-on" src="./src/assets/img/tree/chev-down.svg" width="12" height="12" alt="">
            </button>
          </span>
        </div>
        <ul class="tree__leaves" id="treeCatch" role="list">
          <li class="tree__leaf">
            <span class="tree__line tree__line--d5" aria-hidden="true">
              <img src="./src/assets/img/tree/line-d5.svg" alt="">
            </span>
            <label class="tree__main">
              <input class="tree__check" type="checkbox" name="tree">
              <span class="tree__zone" aria-hidden="true"></span>
              <span class="tree__name">연근해 어획량</span>
            </label>
            <span class="tree__acts">
              <button type="button" class="leaf__star" aria-label="연근해 어획량 즐겨찾기" aria-pressed="false">
                <img class="leaf__star-off" src="./src/assets/img/icon/star-line.svg" width="16" height="16" alt="">
                <img class="leaf__star-on" src="./src/assets/img/icon/star.svg" width="16" height="16" alt="">
              </button>
              <button type="button" class="leaf__info" aria-label="연근해 어획량 정보">
                <img src="./src/assets/img/icon/info.svg" width="16" height="16" alt="">
              </button>
            </span>
          </li>
          <li class="tree__leaf">
            <span class="tree__line tree__line--d5" aria-hidden="true">
              <img src="./src/assets/img/tree/line-d5.svg" alt="">
            </span>
            <label class="tree__main">
              <input class="tree__check" type="checkbox" name="tree">
              <span class="tree__zone" aria-hidden="true"></span>
              <span class="tree__name">연근해 어선밀집도</span>
            </label>
            <span class="tree__acts">
              <button type="button" class="leaf__star" aria-label="연근해 어선밀집도 즐겨찾기" aria-pressed="false">
                <img class="leaf__star-off" src="./src/assets/img/icon/star-line.svg" width="16" height="16" alt="">
                <img class="leaf__star-on" src="./src/assets/img/icon/star.svg" width="16" height="16" alt="">
              </button>
              <button type="button" class="leaf__info" aria-label="연근해 어선밀집도 정보">
                <img src="./src/assets/img/icon/info.svg" width="16" height="16" alt="">
              </button>
            </span>
          </li>
          <li class="tree__leaf">
            <span class="tree__line tree__line--d5" aria-hidden="true">
              <img src="./src/assets/img/tree/line-d5-end.svg" alt="">
            </span>
            <label class="tree__main">
              <input class="tree__check" type="checkbox" name="tree">
              <span class="tree__zone" aria-hidden="true"></span>
              <span class="tree__name">단위노력당 어획량</span>
            </label>
            <span class="tree__acts">
              <button type="button" class="leaf__star" aria-label="단위노력당 어획량 즐겨찾기" aria-pressed="false">
                <img class="leaf__star-off" src="./src/assets/img/icon/star-line.svg" width="16" height="16" alt="">
                <img class="leaf__star-on" src="./src/assets/img/icon/star.svg" width="16" height="16" alt="">
              </button>
              <button type="button" class="leaf__info" aria-label="단위노력당 어획량 정보">
                <img src="./src/assets/img/icon/info.svg" width="16" height="16" alt="">
              </button>
            </span>
          </li>
        </ul>
      </div>
      <div class="tree__sub">
        <span class="tree__line" aria-hidden="true">
          <img src="./src/assets/img/tree/line-d4.svg" alt="">
        </span>
        <label class="tree__main">
          <input class="tree__check" type="checkbox" name="tree">
          <span class="tree__name">양식</span>
        </label>
        <span class="tree__right">
          <span class="tree__count">2</span>
          <button type="button" class="tree__fold" aria-expanded="false" aria-label="양식 펼치기">
            <img class="tree__chev-off" src="./src/assets/img/tree/chev-right.svg" width="12" height="12" alt="">
            <img class="tree__chev-on" src="./src/assets/img/tree/chev-down.svg" width="12" height="12" alt="">
          </button>
        </span>
      </div>
      <div class="tree__sub">
        <span class="tree__line" aria-hidden="true">
          <img src="./src/assets/img/tree/line-d4-end.svg" alt="">
        </span>
        <label class="tree__main">
          <input class="tree__check" type="checkbox" name="tree">
          <span class="tree__name">수산자원관리</span>
        </label>
        <span class="tree__right">
          <span class="tree__count">2</span>
          <button type="button" class="tree__fold" aria-expanded="false" aria-label="수산자원관리 펼치기">
            <img class="tree__chev-off" src="./src/assets/img/tree/chev-right.svg" width="12" height="12" alt="">
            <img class="tree__chev-on" src="./src/assets/img/tree/chev-down.svg" width="12" height="12" alt="">
          </button>
        </span>
      </div>
    </div>
  </div>

  {{#each treeCats}}
  <div class="tree__row">
    <label class="tree__main">
      <input class="tree__check" type="checkbox" name="tree">
      <span class="tree__zone" aria-hidden="true"></span>
      <span class="tree__name">{{this}}</span>
    </label>
    <button type="button" class="tree__fold" aria-expanded="false" aria-label="{{this}} 펼치기">
      <img class="tree__chev-off" src="./src/assets/img/tree/chev-right.svg" width="12" height="12" alt="">
      <img class="tree__chev-on" src="./src/assets/img/tree/chev-down.svg" width="12" height="12" alt="">
    </button>
  </div>
  {{/each}}
</div>
