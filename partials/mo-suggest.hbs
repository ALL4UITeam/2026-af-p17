{{!--
  모바일 추천레이어 FAB + 시트
  PC suggest(129:71183) 참고 — 칩 + 추천 레이어 목록 (모바일 시안 없음)
--}}
<button type="button" class="mo-suggest" data-action="suggest" aria-expanded="false" aria-controls="moSuggestSheet" aria-label="추천레이어"></button>

<section class="mo-sg" id="moSuggestSheet" hidden aria-label="추천레이어">
