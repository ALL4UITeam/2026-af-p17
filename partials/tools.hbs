{{!-- data-action="tool|zoom" / data-tool / data-dir / data-bind="zoom-level" --}}
<aside class="tools" id="mapTools" tabindex="-1" aria-label="지도 도구">
  <div class="tools__inner">
    <div class="tools__item">
      <button type="button" class="tools__btn" data-action="tool" data-tool="layer" aria-pressed="false" aria-label="레이어"></button>
      <span class="tools__label">레이어</span>
    </div>
    <div class="tools__item">
      <button type="button" class="tools__btn" data-action="tool" data-tool="basemap" aria-pressed="false" aria-label="배경지도"></button>
      <span class="tools__label">배경지도</span>
    </div>
    <div class="tools__item">
      <button type="button" class="tools__btn" data-action="tool" data-tool="fullmap" aria-pressed="false" aria-label="전체지도"></button>
      <span class="tools__label">전체지도</span>
    </div>
    <div class="tools__item">
      <button type="button" class="tools__btn" data-action="tool" data-tool="dist" aria-pressed="false" aria-label="거리재기"></button>
      <span class="tools__label">거리재기</span>
    </div>
    <div class="tools__item">
      <button type="button" class="tools__btn" data-action="tool" data-tool="area" aria-pressed="false" aria-label="면적재기"></button>
      <span class="tools__label">면적재기</span>
    </div>
    <div class="tools__item">
      <button type="button" class="tools__btn" data-action="tool" data-tool="print" aria-pressed="false" aria-label="인쇄"></button>
      <span class="tools__label">인쇄</span>
    </div>
  </div>
  <div class="tools__zoom">
    <button type="button" class="tools__zoom-btn" data-action="zoom" data-dir="in" aria-label="확대"></button>
    <div
      class="tools__rail"
      role="slider"
      tabindex="0"
      aria-label="지도 축척"
      aria-valuemin="1"
      aria-valuemax="10"
      aria-valuenow="5"
      aria-valuetext="레벨 5"
    >
      <span class="tools__ticks tools__ticks--l" aria-hidden="true"></span>
      <span class="tools__ticks tools__ticks--r" aria-hidden="true"></span>
      <span class="tools__rail-bg"></span>
      <span class="tools__rail-on"></span>
      <span class="tools__knob"></span>
    </div>
    <span class="tools__lv" data-bind="zoom-level">Lv.5</span>
    <button type="button" class="tools__zoom-btn" data-action="zoom" data-dir="out" aria-label="축소"></button>
  </div>
</aside>
