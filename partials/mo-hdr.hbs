{{!-- 모바일 헤더. PC에서는 hide-mo 로 숨김. --}}
<header class="mo-hdr">
  <div class="mo-mast">
    <span class="mo-mast__flag" aria-hidden="true">
      <img src="./src/assets/img/mo/flag.svg" width="20" height="13" alt="">
    </span>
    <p class="mo-mast__txt">이 누리집은 대한민국 공식 전자정부 누리집입니다.</p>
  </div>
  <div class="mo-bar">
    <div class="mo-bar__row">
      <button type="button" class="mo-bar__ico" data-action="mo-menu" aria-expanded="false" aria-controls="moMenu" aria-label="전체 메뉴">
        <img class="mo-bar__menu" src="./src/assets/img/mo/menu.svg" width="16" height="12" alt="">
        <img class="mo-bar__close" src="./src/assets/img/mo/close.svg" width="30" height="30" alt="">
      </button>
      <div class="mo-bar__brand">
        <span class="mo-bar__logo" aria-hidden="true">
          <img src="./src/assets/img/mo/logo.svg" alt="해양수산공간정보플랫폼">
        </span>
      </div>
      <button type="button" class="mo-bar__ico" data-action="mo-user" aria-label="나의 메뉴">
        <img src="./src/assets/img/mo/user.svg" width="16" height="16" alt="">
      </button>
    </div>
    <form class="mo-search" action="#" method="get" role="search" onsubmit="return false;">
      <button type="button" class="mo-search__list" data-action="mo-sheet" aria-label="공간정보 목록">
        <img src="./src/assets/img/mo/list.svg" width="40" height="40" alt="">
      </button>
      <div class="mo-search__field">
        <label class="sr-only" for="moKeyword">지역, 해역명, 구역명 검색</label>
        <input class="mo-search__input" id="moKeyword" name="q" type="search" placeholder="지역, 해역명, 구역명 검색" data-bind="keyword">
        <button type="button" class="mo-search__go" data-action="search" data-target="moKeyword" aria-label="검색">
          <img src="./src/assets/img/mo/search.svg" width="16" height="16" alt="">
        </button>
      </div>
      <button type="button" class="mo-search__filter" data-action="filter" aria-expanded="false" aria-controls="filterPop" aria-label="필터">
        <img src="./src/assets/img/mo/filter.svg" width="24" height="24" alt="">
      </button>
    </form>
  </div>
</header>
