<aside
  class="panel tour"
  id="tourPanel"
  role="region"
  aria-labelledby="tourPanelTitle"
  tabindex="-1"
  hidden
>
  <div class="panel__title">
    <strong id="tourPanelTitle">관광정보지도</strong>
    <button type="button" class="panel__close" id="tourClose" aria-label="관광정보지도 패널 닫기">
      <img src="./src/assets/img/icon/chevron.svg" alt="" aria-hidden="true">
    </button>
  </div>

  <div class="panel__body tour__body">
    <div class="tabs tabs--4" role="tablist" aria-label="관광 유형">
      <button type="button" class="tab tab--on tab--sm" role="tab" aria-selected="true">관광정보</button>
      <button type="button" class="tab tab--sm" role="tab" aria-selected="false">마리나관광</button>
      <button type="button" class="tab tab--sm" role="tab" aria-selected="false">해양예보</button>
      <button type="button" class="tab tab--sm" role="tab" aria-selected="false">관광통계</button>
    </div>

    <div class="filter">
      <div class="filter__row">
        <button type="button" class="select" aria-haspopup="listbox" aria-label="시 선택">
          <span>시</span>
          <img src="./src/assets/img/icon/select.svg" alt="" aria-hidden="true">
        </button>
        <span class="filter__dash" aria-hidden="true">-</span>
        <button type="button" class="select" aria-haspopup="listbox" aria-label="군 선택">
          <span>군</span>
          <img src="./src/assets/img/icon/select.svg" alt="" aria-hidden="true">
        </button>
      </div>
      <div class="filter__search">
        <div class="filter__input">
          <label class="sr-only" for="tourSearchInput">관광정보 검색</label>
          <input id="tourSearchInput" type="search" placeholder="내용입력" autocomplete="off">
          <button type="button" class="filter__btn" aria-label="관광정보 검색 실행">
            <img src="./src/assets/img/icon/search-sm.svg" alt="" aria-hidden="true">
          </button>
        </div>
        <button type="button" class="filter__gana" aria-pressed="false" aria-label="가나다 정렬">
          <img src="./src/assets/img/icon/gana.svg" alt="" aria-hidden="true">
          <span>가나다</span>
        </button>
      </div>
    </div>

    <section class="cats">
      <div class="cats__head">
        <strong>카테고리</strong>
        <span>(출처:한국관광공사,행정안전부,건강보험시험평가원)</span>
      </div>
      <div class="cats__grid" role="group" aria-label="관광 카테고리">
        <button type="button" class="cat cat--on" aria-pressed="true">전체</button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/stay.svg" alt="" aria-hidden="true">
          <span>숙박</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/course.svg" alt="" aria-hidden="true">
          <span>코스</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/fest.svg" alt="" aria-hidden="true">
          <span class="cat__sm">축제/공연/행사</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/leisure.svg" alt="" aria-hidden="true">
          <span>레저스포츠</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/nature.svg" alt="" aria-hidden="true">
          <span>자연관광</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/shop.svg" alt="" aria-hidden="true">
          <span>쇼핑</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/culture.svg" alt="" aria-hidden="true">
          <span>문화관광</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/exp.svg" alt="" aria-hidden="true">
          <span>체험관광</span>
        </button>
        <button type="button" class="cat" aria-pressed="false">
          <img src="./src/assets/img/cat/safe.svg" alt="" aria-hidden="true">
          <span>생활안전</span>
        </button>
      </div>
    </section>

    <section class="list">
      <div class="list__bar">
        <strong>전체데이터</strong>
        <p>
          검색결과
          <b>2,527</b>
          건
        </p>
      </div>
      <div class="list__items">
        <button type="button" class="card card--on" data-detail="1" aria-pressed="true">
          <div class="card__txt">
            <span class="badge">축제/공연/행사</span>
            <strong>홍성 국가유산 야행</strong>
            <p>충청남도 홍성군 홍성읍 아문길 27</p>
          </div>
          <img class="card__thumb" src="./src/assets/img/tour/t1.png" alt="">
        </button>
        <button type="button" class="card" data-detail="2">
          <div class="card__txt">
            <span class="badge">쇼핑</span>
            <strong>유리알유희</strong>
            <p>강원특별자치도 강릉시 창해로 351-2 (강문동)</p>
          </div>
          <img class="card__thumb" src="./src/assets/img/tour/t2.png" alt="">
        </button>
        <button type="button" class="card" data-detail="3">
          <div class="card__txt">
            <span class="badge">축제/공연/행사</span>
            <strong>삼길포 우럭축제</strong>
            <p>충청남도 서산시 대산읍 삼길포1로 72-2</p>
          </div>
          <img class="card__thumb" src="./src/assets/img/tour/t3.png" alt="">
        </button>
        <button type="button" class="card" data-detail="4">
          <div class="card__txt">
            <span class="badge">축제/공연/행사</span>
            <strong>시흥월곶포구축제</strong>
            <p>경기도 시흥시 월곶해안로 188(월곳동)</p>
          </div>
          <img class="card__thumb" src="./src/assets/img/tour/t4.png" alt="">
        </button>
        <button type="button" class="card" data-detail="5">
          <div class="card__txt">
            <span class="badge">문화관광</span>
            <strong>소금포역사관</strong>
            <p>울산광역시 북구 새장터6길 8(염포동)</p>
          </div>
          <img class="card__thumb" src="./src/assets/img/tour/t5.png" alt="">
        </button>
      </div>
    </section>
  </div>
</aside>
