<aside
  class="panel"
  id="searchPanel"
  role="region"
  aria-labelledby="searchPanelTitle"
  tabindex="-1"
  hidden
>
  <div class="panel__title">
    <strong id="searchPanelTitle">통합검색</strong>
    <button type="button" class="panel__close" id="panelClose" aria-label="통합검색 패널 닫기">
      <img src="./src/assets/icon/chevron.svg" alt="" aria-hidden="true">
    </button>
  </div>

  <div class="panel__body panel__body--result">
    <div class="tabs" role="tablist" aria-label="검색 유형">
      <button type="button" class="tab tab--on" role="tab" id="tabKw" aria-controls="tabPanelSearch" aria-selected="true" tabindex="0" data-tab="kw">
        <span class="tab__ico" aria-hidden="true">
          <img src="./src/assets/icon/tab-kw.svg" alt="">
        </span>
        키워드
      </button>
      <button type="button" class="tab" role="tab" id="tabList" aria-controls="tabPanelSearch" aria-selected="false" tabindex="-1" data-tab="list">
        <span class="tab__ico" aria-hidden="true">
          <img src="./src/assets/icon/tab-list.svg" alt="">
        </span>
        목록
      </button>
      <button type="button" class="tab" role="tab" id="tabArea" aria-controls="tabPanelSearch" aria-selected="false" tabindex="-1" data-tab="area">
        <span class="tab__ico tab__ico--area" aria-hidden="true">
          <img src="./src/assets/icon/tab-area2.svg" alt="">
          <img src="./src/assets/icon/tab-area.svg" alt="">
        </span>
        지역
      </button>
    </div>

    <div class="search" id="tabPanelSearch" role="tabpanel" aria-labelledby="tabKw">
      <p class="search__hint" id="searchHint">키워드를 입력하여 해양공간 정보를 검색합니다.</p>
      <div class="search__box">
        <label class="sr-only" for="searchInput">통합검색 키워드</label>
        <input
          class="search__input"
          id="searchInput"
          type="search"
          value="거제 해양관광"
          placeholder="내용을 입력하세요"
          aria-describedby="searchHint"
          autocomplete="off"
        >
        <button type="button" class="search__btn" aria-label="검색 실행">
          <img src="./src/assets/icon/search.svg" alt="" aria-hidden="true">
        </button>
      </div>
    </div>

    <div class="result" aria-label="검색 결과">
      <div class="result__head">
        <p>
          <strong>“거제 해양관광”</strong>
          <span>검색 결과</span>
        </p>
        <button type="button" class="result__reset">
          <img src="./src/assets/result/reset.svg" alt="" aria-hidden="true">
          초기화
        </button>
      </div>

      <section class="sec" aria-labelledby="sec1Title">
        <h2 class="sr-only" id="sec1Title">공간정보 종합지도 레이어</h2>
        <button type="button" class="sec__title" aria-expanded="true" aria-controls="sec1List">
          <span class="sec__left">
            <span class="sec__ico" aria-hidden="true"><img src="./src/assets/result/sec1.svg" alt=""></span>
            공간정보 종합지도 레이어
          </span>
          <span class="sec__right">
            <span class="sec__count">총 28건</span>
            <img src="./src/assets/result/chev-down.svg" alt="" aria-hidden="true">
          </span>
        </button>
        <ul class="sec__list" id="sec1List" role="list">
          <li class="sec__item" tabindex="0">
            <span class="dot" style="--dot:#dd5f5f" aria-hidden="true"></span>
            <div class="sec__txt">
              <strong>어업활동보호</strong>
              <p>공간정보</p>
            </div>
            <span class="sec__badge">12건</span>
          </li>
          <li class="sec__item">
            <span class="dot" style="--dot:#00bd73"></span>
            <div class="sec__txt">
              <strong>어업자원</strong>
