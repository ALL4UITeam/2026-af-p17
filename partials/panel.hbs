              <div class="tree__branch" id="kids-marina" data-group-id="marina">
                <div class="tree__d5">
                  <div class="tree__d5-left">
                    <span class="tree__line" aria-hidden="true"><img src="./src/assets/img/tree/line.svg" width="40" height="40" alt=""></span>
                    <div class="tree__d5-txt">
                      <label class="chk">
                        <input class="chk__input" type="checkbox" name="layer" value="GRP_MARINA_STATUS" data-action="toggle-layer" data-layer-id="GRP_MARINA_STATUS" data-layer-name="전국 마리나 현황">
                        <span class="chk__box" aria-hidden="true"><img src="./src/assets/img/icon/check.svg" width="16" height="16" alt=""></span>
                      </label>
                      <p class="tree__leaf is-off">전국 마리나 현황</p>
                    </div>
                  </div>
                  <button type="button" class="tree__d5-right" data-action="toggle" data-toggle="branch" data-group-id="marina-status" aria-expanded="false" aria-controls="leaves-marina-status">
                    <span class="count">1</span>
                    <span class="tree__d5-ico" aria-hidden="true">
                      <img class="ico-open" src="./src/assets/img/icon/row-minus.svg" width="18" height="18" alt="">
                      <img class="ico-close" src="./src/assets/img/icon/row-plus.svg" width="18" height="18" alt="">
                    </span>
                  </button>
                </div>
                <div class="tree__leaves" id="leaves-marina-status" hidden>
                  <div class="tree__d6">
                    <div class="tree__d6-left">
                      <span class="tree__line tree__line--d6" aria-hidden="true"><img src="./src/assets/img/tree/line-d6.svg" width="67" height="40" alt=""></span>
                      <div class="tree__d6-txt">
                        <label class="chk">
                          <input class="chk__input" type="checkbox" name="layer" value="LYR_MARINA_STATUS" data-action="toggle-layer" data-layer-id="LYR_MARINA_STATUS" data-layer-name="전국 마리나 현황" data-parent-id="GRP_MARINA_STATUS">
                          <span class="chk__box" aria-hidden="true"><img src="./src/assets/img/icon/check.svg" width="16" height="16" alt=""></span>
                        </label>
                        <p class="tree__leaf"><span class="lyr-mark" aria-hidden="true"></span>전국 마리나 현황</p>
                      </div>
                    </div>
                    <span class="tree__d5-right">
                      <span class="count">3</span>
                      <span class="tree__d5-ico" aria-hidden="true"><img src="./src/assets/img/icon/row-plus.svg" width="18" height="18" alt=""></span>
                    </span>
                  </div>
                </div>
                <div class="tree__d5">
                  <div class="tree__d5-left">
                    <span class="tree__line" aria-hidden="true"><img src="./src/assets/img/tree/line-end.svg" width="40" height="40" alt=""></span>
                    <div class="tree__d5-txt">
                      <label class="chk">
                        <input class="chk__input" type="checkbox" name="layer" value="GRP_MARINA_CO" data-action="toggle-layer" data-layer-id="GRP_MARINA_CO" data-layer-name="마리나 등록 업체">
                        <span class="chk__box" aria-hidden="true"><img src="./src/assets/img/icon/check.svg" width="16" height="16" alt=""></span>
                      </label>
                      <p class="tree__leaf is-off">마리나 등록 업체</p>
                    </div>
                  </div>
                  <span class="tree__d5-right">
                    <span class="count">3</span>
                    <span class="tree__d5-ico" aria-hidden="true"><img src="./src/assets/img/icon/row-plus.svg" width="18" height="18" alt=""></span>
                  </span>
                </div>
              </div>
              <button type="button" class="tree__d3" data-action="toggle" data-toggle="group" data-group-id="forecast" aria-expanded="false" aria-controls="kids-forecast">
                <span class="tree__d3-txt">해양예보</span>
                <span class="tree__d3-right">
                  <span class="count">4</span>
                  <span class="tree__d3-ico" aria-hidden="true">
                    <img class="ico-open" src="./src/assets/img/icon/tree-minus.svg" width="18" height="18" alt="">
                    <img class="ico-close" src="./src/assets/img/icon/tree-plus.svg" width="18" height="18" alt="">
                  </span>
                </span>
              </button>
              <div class="tree__branch" id="kids-forecast" data-group-id="forecast">
                {{#each forecastLayers}}
                <div class="tree__d4 tree__d4--pick">
                  <label class="tree__d4-left">
                    <span class="radio">
                      <input class="radio__input" type="radio" name="forecastLayer" value="{{id}}" data-layer-id="{{id}}" data-layer-name="{{name}}">
                      <span class="radio__box" aria-hidden="true"></span>
                    </span>
                    <span class="tree__d4-txt">{{name}}</span>
                  </label>
                  <span class="tree__acts">
                    <button type="button" class="tree__act" data-action="info-layer" data-layer-id="{{id}}" aria-pressed="false" aria-label="{{name}} 정보">
                      <img class="ico-off" src="./src/assets/img/icon/info.svg" width="20" height="20" alt="">
                      <img class="ico-on" src="./src/assets/img/icon/info-on.svg" width="20" height="20" alt="">
                    </button>
                    <button type="button" class="tree__act" data-action="fav-layer" data-layer-id="{{id}}" aria-pressed="false" aria-label="{{name}} 관심">
                      <img class="ico-off" src="./src/assets/img/icon/star.svg" width="20" height="20" alt="">
                      <img class="ico-on" src="./src/assets/img/icon/star-on.svg" width="20" height="20" alt="">
                    </button>
                  </span>
                </div>
                {{/each}}
              </div>
              <button type="button" class="tree__d3" data-action="toggle" data-toggle="group" data-group-id="tour-stat" aria-expanded="false" aria-controls="kids-tour-stat">
                <span class="tree__d3-txt">관광통계</span>
                <span class="tree__d3-right">
                  <span class="count">2</span>
                  <span class="tree__d3-ico" aria-hidden="true">
                    <img class="ico-open" src="./src/assets/img/icon/tree-minus.svg" width="18" height="18" alt="">
                    <img class="ico-close" src="./src/assets/img/icon/tree-plus.svg" width="18" height="18" alt="">
                  </span>
                </span>
              </button>
              <div class="tree__branch" id="kids-tour-stat" data-group-id="tour-stat">
                {{#each tourStatLayers}}
                <div class="tree__d4 tree__d4--pick">
                  <label class="tree__d4-left">
                    <span class="radio">
                      <input class="radio__input" type="radio" name="tourStatLayer" value="{{id}}" data-layer-id="{{id}}" data-layer-name="{{name}}">
                      <span class="radio__box" aria-hidden="true"></span>
                    </span>
                    <span class="tree__d4-txt">{{name}}</span>
                  </label>
                  <span class="tree__acts">
                    <button type="button" class="tree__act" data-action="info-layer" data-layer-id="{{id}}" aria-pressed="false" aria-label="{{name}} 정보">
                      <img class="ico-off" src="./src/assets/img/icon/info.svg" width="20" height="20" alt="">
                      <img class="ico-on" src="./src/assets/img/icon/info-on.svg" width="20" height="20" alt="">
                    </button>
                    <button type="button" class="tree__act" data-action="fav-layer" data-layer-id="{{id}}" aria-pressed="false" aria-label="{{name}} 관심">
                      <img class="ico-off" src="./src/assets/img/icon/star.svg" width="20" height="20" alt="">
                      <img class="ico-on" src="./src/assets/img/icon/star-on.svg" width="20" height="20" alt="">
                    </button>
                  </span>
                </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="panel__list" id="panelFav" role="tabpanel" aria-labelledby="tabFav" hidden></div>
  </div>
  <div class="panel__handle">
    <button type="button" class="panel__handle-btn" data-action="collapse-panel" aria-expanded="true" aria-controls="layerPanel" aria-label="패널 접기">
      <img src="./src/assets/img/icon/panel-close.svg" width="16" height="16" alt="">
    </button>
  </div>
</section>
