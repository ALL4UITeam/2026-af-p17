<aside
  class="panel"
  id="layerPanel"
  aria-label="공간정보 검색 및 레이어"
  tabindex="-1"
>
  <div class="panel__inner">
    <div class="panel__wave" aria-hidden="true">
      <img src="./src/assets/img/panel-wave.png" alt="">
    </div>

    <form class="search" role="search" action="#" method="get">
      <label class="sr-only" for="placeSearch">지명, 해역명, 구역명 검색</label>
      <div class="search__field">
        <input
          class="search__input"
          id="placeSearch"
          type="search"
          name="q"
          placeholder="지명, 해역명, 구역명 검색"
          autocomplete="off"
        >
        <button type="submit" class="search__btn" aria-label="검색">
          <span class="search__btn-ico" aria-hidden="true">
            <img src="./src/assets/img/icon/search.svg" alt="">
          </span>
        </button>
      </div>
      <button type="button" class="search__filter" aria-label="상세 검색 필터" aria-expanded="false">
        <span class="search__filter-ico" aria-hidden="true">
          <img src="./src/assets/img/icon/filter.svg" alt="">
        </span>
      </button>
    </form>

    <ul class="layer" role="list">
      <li>
        <button
          type="button"
          class="layer__item"
          aria-expanded="false"
          aria-controls="layerMap"
        >
          <span class="layer__left">
            <span class="layer__ico" aria-hidden="true">
              <img class="layer__ico-off" src="./src/assets/img/panel/layer-map.svg" alt="">
              <img class="layer__ico-on" src="./src/assets/img/panel/layer-map-on.svg" alt="">
            </span>
            <span class="layer__name">종합지도</span>
          </span>
          <span class="layer__right">
            <span class="layer__count">19</span>
            <span class="layer__chev" aria-hidden="true">
              <img class="layer__chev-off" src="./src/assets/img/icon/chevron-down.svg" width="16" height="16" alt="">
              <img class="layer__chev-on" src="./src/assets/img/icon/chevron-down-on.svg" width="16" height="16" alt="">
            </span>
          </span>
        </button>
        <div class="layer__body" id="layerMap" hidden>
          <ul class="sub" role="list">
            {{#each mapGroups}}
            <li>
              <button
                type="button"
                class="sub__row{{#if open}} sub__row--on{{/if}}"
                aria-expanded="{{#if open}}true{{else}}false{{/if}}"
                aria-controls="{{id}}"
              >
                <span class="sub__name">{{name}}</span>
                <span class="sub__right">
                  <span class="sub__count">{{count}}</span>
                  <span class="sub__toggle" aria-hidden="true">
                    <img class="sub__toggle-plus" src="./src/assets/img/icon/plus.svg" width="18" height="18" alt="">
                    <img class="sub__toggle-minus" src="./src/assets/img/icon/minus.svg" width="18" height="18" alt="">
                  </span>
                </span>
              </button>
              <ul class="leaf" id="{{id}}" {{#unless open}}hidden{{/unless}} role="list">
                {{#each leaves}}
                <li class="leaf__row">
                  <label class="leaf__main">
                    <input class="leaf__check" type="checkbox" name="layer">
                    <span class="leaf__legend" aria-hidden="true">
                      <img src="./src/assets/img/legend/lyr-{{ico}}.svg" width="14" height="14" alt="">
                    </span>
                    <span class="leaf__name">{{name}}</span>
                  </label>
                  <div class="leaf__acts">
                    <button type="button" class="leaf__star" aria-label="{{name}} 즐겨찾기" aria-pressed="false">
                      <img class="leaf__star-off" src="./src/assets/img/icon/star-line.svg" width="16" height="16" alt="">
                      <img class="leaf__star-on" src="./src/assets/img/icon/star.svg" width="16" height="16" alt="">
                    </button>
                    <button type="button" class="leaf__info" aria-label="{{name}} 정보">
                      <img src="./src/assets/img/icon/info.svg" width="16" height="16" alt="">
                    </button>
                  </div>
                </li>
                {{/each}}
              </ul>
            </li>
            {{/each}}
          </ul>
        </div>
      </li>
      <li>
        <button
          type="button"
          class="layer__item"
          aria-expanded="true"
          aria-controls="layerPlan"
        >
          <span class="layer__left">
            <span class="layer__ico" aria-hidden="true">
              <img class="layer__ico-off" src="./src/assets/img/panel/layer-plan.svg" alt="">
              <img class="layer__ico-on" src="./src/assets/img/panel/layer-plan-on.svg" alt="">
            </span>
            <span class="layer__name">관리계획</span>
          </span>
          <span class="layer__right">
            <span class="layer__count">6</span>
            <span class="layer__chev" aria-hidden="true">
              <img class="layer__chev-off" src="./src/assets/img/icon/chevron-down.svg" width="16" height="16" alt="">
              <img class="layer__chev-on" src="./src/assets/img/icon/chevron-down-on.svg" width="16" height="16" alt="">
            </span>
          </span>
        </button>
        <div class="layer__body" id="layerPlan">
          <ul class="sub" role="list">
            <li>
              <button
                type="button"
                class="sub__row sub__row--on"
                aria-expanded="true"
                aria-controls="treeEval"
              >
                <span class="sub__name">해양공간 특성평가 결과</span>
                <span class="sub__right">
                  <span class="sub__count">9</span>
                  <span class="sub__toggle" aria-hidden="true">
                    <img class="sub__toggle-plus" src="./src/assets/img/icon/plus.svg" width="18" height="18" alt="">
                    <img class="sub__toggle-minus" src="./src/assets/img/icon/minus.svg" width="18" height="18" alt="">
                  </span>
                </span>
              </button>
              {{> tree}}
            </li>
            <li>
              <div class="sub__row">
                <span class="sub__name">상충분석결과</span>
                <span class="sub__right">
                  <span class="sub__count">9</span>
                  <button type="button" class="sub__add" aria-label="상충분석결과 추가" aria-pressed="false">
                    <span class="sub__add-ico" aria-hidden="true">
                      <img src="./src/assets/img/icon/plus.svg" width="18" height="18" alt="">
                    </span>
                  </button>
                </span>
              </div>
            </li>
            <li>
              <div class="sub__row">
                <span class="sub__name">해양공간관리계획도</span>
                <span class="sub__right">
                  <span class="sub__count">9</span>
                  <button type="button" class="sub__add" aria-label="해양공간관리계획도 추가" aria-pressed="false">
                    <span class="sub__add-ico" aria-hidden="true">
                      <img src="./src/assets/img/icon/plus.svg" width="18" height="18" alt="">
                    </span>
                  </button>
                </span>
              </div>
            </li>
            <li>
              <div class="sub__row">
                <span class="sub__name">해양공간관리계획도 관리구역</span>
                <span class="sub__right">
                  <span class="sub__count">9</span>
                  <button type="button" class="sub__add" aria-label="해양공간관리계획도 관리구역 추가" aria-pressed="false">
                    <span class="sub__add-ico" aria-hidden="true">
                      <img src="./src/assets/img/icon/plus.svg" width="18" height="18" alt="">
                    </span>
                  </button>
                </span>
              </div>
            </li>
            <li>
              <div class="sub__row">
                <span class="sub__name">해양공간계획 기초자료</span>
                <span class="sub__right">
                  <span class="sub__count">9</span>
                  <button type="button" class="sub__add" aria-label="해양공간계획 기초자료 추가" aria-pressed="false">
                    <span class="sub__add-ico" aria-hidden="true">
                      <img src="./src/assets/img/icon/plus.svg" width="18" height="18" alt="">
                    </span>
                  </button>
                </span>
              </div>
            </li>
            <li>
              <div class="sub__row">
                <span class="sub__name">기본공간정보</span>
                <span class="sub__right">
                  <span class="sub__count">1</span>
                  <button type="button" class="sub__add" aria-label="기본공간정보 추가" aria-pressed="false">
                    <span class="sub__add-ico" aria-hidden="true">
                      <img src="./src/assets/img/icon/plus.svg" width="18" height="18" alt="">
                    </span>
                  </button>
                </span>
              </div>
            </li>
          </ul>
        </div>
      </li>
      <li>
        <button
          type="button"
          class="layer__item"
          aria-expanded="false"
          aria-controls="layerBiz"
        >
          <span class="layer__left">
            <span class="layer__ico" aria-hidden="true">
              <img class="layer__ico-off" src="./src/assets/img/panel/layer-biz.svg" alt="">
              <img class="layer__ico-on" src="./src/assets/img/panel/layer-biz-on.svg" alt="">
            </span>
            <span class="layer__name">사업정보</span>
          </span>
          <span class="layer__right">
            <span class="layer__count">10</span>
            <span class="layer__chev" aria-hidden="true">
              <img class="layer__chev-off" src="./src/assets/img/icon/chevron-down.svg" width="16" height="16" alt="">
              <img class="layer__chev-on" src="./src/assets/img/icon/chevron-down-on.svg" width="16" height="16" alt="">
            </span>
          </span>
        </button>
        <div class="layer__body" id="layerBiz" hidden></div>
      </li>
    </ul>
  </div>
</aside>
