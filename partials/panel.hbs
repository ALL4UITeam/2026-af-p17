      <button type="button" class="panel__tab" role="tab" id="tabFav" aria-selected="false" aria-controls="panelFav" data-action="tab" data-tab="fav">관심 레이어</button>
    </div>
    <form class="panel__search" action="#" method="get" role="search" onsubmit="return false;">
      <div class="panel__field">
        <label class="sr-only" for="pcKeyword">지명, 해역명, 구역명 검색</label>
        <input class="panel__input" id="pcKeyword" name="q" type="search" placeholder="지명, 해역명, 구역명 검색" data-bind="keyword">
        <button type="button" class="panel__search-btn" data-action="search" data-target="pcKeyword" aria-label="검색"></button>
      </div> 
      <button type="button" class="panel__filter" data-action="filter" aria-expanded="false" aria-controls="filterPop" aria-label="필터"></button>
    </form>
