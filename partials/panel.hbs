{{!--
  공간정보 목록
  - data-action / data-layer-id / data-group-id 로 연동
  - 체크박스는 KRDS용 네이티브 input. 화면만 .chk__box
--}}
<section class="panel" id="layerPanel" tabindex="-1" aria-label="공간정보 목록">
  <div class="panel__body">
    <div class="panel__tabs" role="tablist" aria-label="목록 구분">
      <button type="button" class="panel__tab is-active" role="tab" id="tabList" aria-selected="true" aria-controls="panelList" data-action="tab" data-tab="list">공간정보 목록</button>
      <button type="button" class="panel__tab" role="tab" id="tabFav" aria-selected="false" aria-controls="panelFav" data-action="tab" data-tab="fav">관심 레이어</button>
    </div>
    <form class="panel__search" action="#" method="get" role="search" onsubmit="return false;">
      <div class="panel__field">
        <label class="sr-only" for="pcKeyword">지명, 해역명, 구역명 검색</label>
        <input class="panel__input" id="pcKeyword" name="q" type="search" placeholder="지명, 해역명, 구역명 검색" data-bind="keyword">
        <button type="button" class="panel__search-btn" data-action="search" data-target="pcKeyword" aria-label="검색">
          <img src="./src/assets/img/icon/search.svg" width="16" height="16" alt="">
        </button>
      </div> 
      <button type="button" class="panel__filter" data-action="filter" aria-expanded="false" aria-controls="filterPop" aria-label="필터">
        <img src="./src/assets/img/icon/filter.svg" width="24" height="24" alt="">
      </button>
    </form>
    <div class="panel__list" id="panelList" role="tabpanel" aria-labelledby="tabList">
