{{!-- 검색 옆 필터 --}}
<aside class="flt" id="filterPop" hidden role="dialog" aria-modal="false" aria-labelledby="filterTitle" tabindex="-1">
  <img class="flt__glass" src="./src/assets/img/glass-panel.png" width="360" height="680" alt="" aria-hidden="true">
  <div class="flt__head">
    <p class="flt__title" id="filterTitle">필터</p>
    <button type="button" class="flt__close" aria-label="필터 닫기"></button>
  </div>
  <div class="flt__body">
    <section class="flt__sec">
      <div class="flt__tit">
        <div class="flt__tit-l">
          <strong>지역</strong>
          <label class="flt__all">
            <button type="button" class="flt__switch" role="switch" aria-checked="false">
              <span>off</span>
            </button>
            전체선택
          </label>
        </div>
        <button type="button" class="flt__fold" aria-expanded="true" aria-label="지역 접기">
        </button>
      </div>
      <div class="flt__grid flt__grid--4">
        <button type="button" class="flt__chip is-on" aria-pressed="true"><span>서울시</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>경기도</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>인천시</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>부산시</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>대전시</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>대구시</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>울산시</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>세종시</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>전남광주</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>강원도</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>충청북도</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>충청남도</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>경상북도</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>경상남도</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>전북도</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>제주도</span></button>
      </div>
    </section>
    <hr class="flt__line">
    <section class="flt__sec">
      <div class="flt__tit">
        <div class="flt__tit-l">
          <strong>카테고리</strong>
          <label class="flt__all">
            <button type="button" class="flt__switch" role="switch" aria-checked="false">
              <span>off</span>
            </button>
            전체선택
          </label>
        </div>
        <button type="button" class="flt__fold" aria-expanded="true" aria-label="카테고리 접기">
        </button>
      </div>
      <div class="flt__grid flt__grid--3">
        <button type="button" class="flt__chip is-on" aria-pressed="true"><span>골재·광물</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>항만·항행</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>군사활동</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>어업활동</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>해양관광</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>해양안전·관리</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>해양환경·생태</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>해양수자원</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>해양에너지</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>기본공간정보</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>해양수산통계</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>해양용도구역</span></button>
      </div>
    </section>
    <hr class="flt__line">
    <section class="flt__sec">
      <div class="flt__tit">
        <div class="flt__tit-l">
          <strong>초성</strong>
          <label class="flt__all">
            <button type="button" class="flt__switch" role="switch" aria-checked="false">
              <span>off</span>
            </button>
            전체선택
          </label>
        </div>
        <button type="button" class="flt__fold" aria-expanded="true" aria-label="초성 접기">
        </button>
      </div>
      <div class="flt__grid flt__grid--7">
        <button type="button" class="flt__chip is-on" aria-pressed="true"><span>ㄱ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㄴ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㄷ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㄹ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅁ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅂ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅅ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅇ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅈ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅊ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅋ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅌ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅍ</span></button>
        <button type="button" class="flt__chip" aria-pressed="false"><span>ㅎ</span></button>
      </div>
    </section>
    <hr class="flt__line">
    <div class="flt__foot">
      <div class="flt__picked">
        <button type="button" class="flt__reset" aria-label="선택 초기화"></button>
        <div class="flt__tags">
          <button type="button" class="flt__tag">서울시</button>
          <button type="button" class="flt__tag">골재·광물</button>
          <button type="button" class="flt__tag">ㄱ</button>
        </div>
      </div>
      <button type="button" class="flt__apply">
        <span class="flt__apply-pc">결과 보기</span>
        <span class="flt__apply-mo">필터 선택 완료</span>
      </button>
    </div>
  </div>
</aside>
